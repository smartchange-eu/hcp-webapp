{
  "name": "heart-ui-angular-template",
  "version": "1.8.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host=127.0.0.1",
    "start:gui": "ng serve --configuration=gui --host=127.0.0.1",
    "start:testvm": "ng serve --configuration=testvm --host=127.0.0.1",
    "build": "ng build",
    "build:docker": "ng build --configuration docker",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "analyze": "webpack-bundle-analyzer ./dist/heart-ui-angular-template/stats.json",
    "analyze:docker": "npm run build:docker -- --stats-json && analyze",
    "docker:build": "npm run build:docker && docker build -f docker/Dockerfile -t ghcr.io/smartchange-eu/webapp:latest -t ghcr.io/smartchange-eu/webapp:1.8.0 .",
    "docker:multipush": "npm run build:docker && docker buildx build --platform linux/amd64,linux/arm64 --push -f docker/Dockerfile -t ghcr.io/smartchange-eu/webapp:latest .",
    "docker:run": "docker run ghcr.io/smartchange-eu/webapp",
    "docker:push": "docker push ghcr.io/smartchange-eu/webapp:latest && docker push ghcr.io/smartchange-eu/webapp:1.8.0",
    "docker:stable": "docker tag ghcr.io/smartchange-eu/webapp:1.8.0 ghcr.io/smartchange-eu/webapp:feasibility-study && docker push ghcr.io/smartchange-eu/webapp:feasibility-study",
    "docker:build-push": "npm run docker:build && npm run docker:push",
    "docker-dev:build": "npm run build:docker && docker build -f docker/Dockerfile -t heart/webapp:latest .",
    "docker-dev:run": "docker run -d -p 4200:4200 heart/webapp",
    "docker:dev-run": "npm run docker-dev:build && npm run docker-dev:run"
  },
  "private": true,
  "dependencies": {
    "@angular-material-components/datetime-picker": "^15.0.0",
    "@angular/animations": "^15.0.1",
    "@angular/cdk": "^15.0.1",
    "@angular/common": "^15.0.1",
    "@angular/compiler": "^15.0.1",
    "@angular/core": "^15.0.1",
    "@angular/forms": "^15.0.1",
    "@angular/material": "^15.0.1",
    "@angular/platform-browser": "^15.0.1",
    "@angular/platform-browser-dynamic": "^15.0.1",
    "@angular/router": "^15.0.1",
    "@eng-it4h/fhir-r5": "file:vendor/heart-ui/eng-it4h-fhir-r5-1.0.2.tgz",
    "@eng-it4h/heart-ui-cdss": "file:vendor/heart-ui/eng-it4h-heart-ui-cdss-4.0.3.tgz",
    "@eng-it4h/heart-ui-connector": "file:vendor/heart-ui/eng-it4h-heart-ui-connector-3.4.6.tgz",
    "@eng-it4h/heart-ui-converter": "file:vendor/heart-ui/eng-it4h-heart-ui-converter-3.4.9.tgz",
    "@eng-it4h/heart-ui-encounter": "file:vendor/heart-ui/eng-it4h-heart-ui-encounter-0.0.1.tgz",
    "@eng-it4h/heart-ui-measure": "file:vendor/heart-ui/eng-it4h-heart-ui-measure-2.8.5.tgz",
    "@eng-it4h/heart-ui-model": "file:vendor/heart-ui/eng-it4h-heart-ui-model-2.16.8.tgz",
    "@eng-it4h/heart-ui-patient": "file:vendor/heart-ui/eng-it4h-heart-ui-patient-2.7.4.tgz",
    "@eng-it4h/heart-ui-questionnaire": "file:vendor/heart-ui/eng-it4h-heart-ui-questionnaire-2.5.1.tgz",
    "@eng-it4h/heart-ui-user": "file:vendor/heart-ui/eng-it4h-heart-ui-user-2.4.6.tgz",
    "@eng-it4h/heart-ui-utils": "file:vendor/heart-ui/eng-it4h-heart-ui-utils-0.7.5.tgz",
    "@ngx-translate/core": "^14.0.0",
    "@ngx-translate/http-loader": "^7.0.0",
    "@primer/css": "^20.8.3",
    "angular-auth-oidc-client": "^15.0.3",
    "lodash-es": "^4.17.21",
    "lorem-ipsum": "^2.0.8",
    "lz-string": "1.4.4",
    "net": "^1.0.2",
    "ngx-date-fns": "^10.0.1",
    "ngx-markdown": "^15.1.2",
    "rxjs": "~7.5.0",
    "secure-ls": "^1.2.6",
    "xng-breadcrumb": "^9.0.0",
    "zone.js": "~0.11.4"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^15.0.0",
    "@angular/cli": "~15.0.0",
    "@angular/compiler-cli": "^15.0.1",
    "@angular/material-date-fns-adapter": "^15.0.0",
    "@swimlane/ngx-charts": "^20.1.2",
    "@types/crypto-js": "^3.1.47",
    "@types/d3": "^7.4.0",
    "@types/jasmine": "~4.0.0",
    "@types/lodash-es": "^4.17.6",
    "@types/lz-string": "1.3.34",
    "@types/node": "^18.14.2",
    "jasmine-core": "~4.3.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.0.0",
    "tslib": "^2.6.2",
    "typescript": "~4.8.4",
    "webpack-bundle-analyzer": "^4.8.0"
  }
}
